{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Read(/nix/store/**)",
      "Bash(ls /nix/store/*)",
      "Bash(cat /nix/store/*)",
      "Bash(find /nix/store/*)",
      "Bash(grep *)",
      "Bash(awk *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "env": {
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "true",
    "GIT_CONFIG_KEY_1": "user.signingkey",
    "GIT_CONFIG_VALUE_1": "/home/b/.ssh/id_ed25519_agent.pub"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.cache/claude-notify && touch ~/.cache/claude-notify/active"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify 'Claude needs input' 'Waiting for your response'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify 'Claude finished' 'Task complete'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sleep 2; if [ -s errors.err ]; then cat errors.err; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
